<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>1.0.5</Version>
		<Authors>obugs</Authors>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Title>RhythmBase.RhythmDoctor.View</Title>
		<Description>Draw all Rhythm Doctor event elements in SkiaSharp.</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<RepositoryUrl>https://github.com/OLDRedstone/RhythmBase.RhythmDoctor.View</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<LangVersion>preview</LangVersion>
		<UserSecretsId>80eb137e-559e-4c02-ae76-bd1a18fc277b</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="..\shared\Assets\assets" Link="Assets\assets" />
		<EmbeddedResource Include="..\shared\Assets\assets.png" Link="Assets\assets.png" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="README.md" />
		<None Include="README.md" Pack="True" PackagePath="\" />
		<None Include="..\LICENSE.txt">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="RhythmBase.RhythmDoctor" Version="1.3.13" />
		<PackageReference Include="SkiaSharp" Version="4.153.0" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
	  <PackageReference Include="OpenTK">
	    <Version>4.9.4</Version>
	  </PackageReference>
	</ItemGroup>

</Project>
